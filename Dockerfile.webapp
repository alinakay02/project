FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-webapp.txt .
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements-webapp.txt

COPY config.yaml .
COPY app/ ./app/
COPY predictor/ ./predictor/
COPY controller/ ./controller/
# Датасеты — нужны для /api/datasets/preview и /api/training/start (загрузка CSV)
COPY data/ ./data/
# Тесты и скрипт-обёртка — нужны для /api/experiments/run (кнопка
# «Запустить тесты» на странице Сравнение). scripts/save_results.py запускает
# pytest tests/test_experiments.py и сохраняет [METRIC]-строки в БД.
COPY tests/ ./tests/
COPY scripts/ ./scripts/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 5000 5001

# Запускаем оба сервера параллельно
CMD ["sh", "-c", "python app/main.py & python app/api.py"]
