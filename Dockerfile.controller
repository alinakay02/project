FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-controller.txt .
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements-controller.txt

COPY config.yaml .
COPY predictor/ ./predictor/
COPY controller/ ./controller/
COPY data/alibaba_cluster_trace_2018.csv ./data/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "controller.bootstrap"]
